---
import BaseHead from '../components/BaseHead.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description="Mert Turkmenoglu" />
  </head>

  <body class="container w-11/12 sm:w-full mx-4 sm:mx-auto my-16 bg-[#0a0a0a] text-white">
    <slot />
  </body>
</html>
