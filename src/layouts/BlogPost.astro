---
import type { CollectionEntry } from "astro:content";
import Navigation from "../components/Navigation.astro";
import BaseHead from "../components/BaseHead.astro";
import LeftArrow from "../components/left-arrow.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, date, image, author } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body
		class="container w-11/12 sm:w-full max-w-5xl mx-4 sm:mx-auto my-16 bg-[#0a0a0a] text-white"
	>
		<header class="not-prose">
			<a
				href="/blog"
				class="hover:underline text-xs hover:text-accent transition-all duration-200 ease-in-out flex items-center gap-2"
			>
				<LeftArrow />
				<span>Blog</span>
			</a>
			<h2 class="text-4xl text-white mt-8">{title}</h2>
			<div class="mt-2 text-sm flex items-baseline">
				<span>{author},</span>
				<span class="ml-1">{new Date(date).toLocaleDateString()}</span>
				<!-- <span class="ml-4 text-xs">{minutesRead}</span> -->
			</div>
		</header>

		<hr class="mb-16 mt-4">

		<main
			class="prose prose-neutral dark:prose-invert prose-yellow prose-p:text-white max-w-none prose-em:text-accent prose-a:text-accent"
		>
			<slot />
		</main>

		<footer class="not-prose mt-16">
			<hr>
			<Navigation />
		</footer>
	</body>
</html>
